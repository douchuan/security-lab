# 端口扫描检测规则

# 规则 1: TCP connect 扫描检测（nmap -sT）
alert tcp any any -> $HOME_NET any (msg:"ET SCAN TCP Port Scan - connect scan detected"; flags:S; threshold: type threshold, track by_src, count 5, seconds 30; sid:1000001; rev:1; classtype:attempted-recon;)

# 规则 2: SYN 扫描检测（nmap -sS）
alert tcp any any -> $HOME_NET any (msg:"ET SCAN SYN Port Scan detected"; flags:S; threshold: type threshold, track by_src, count 5, seconds 30; sid:1000002; rev:1; classtype:attempted-recon;)

# 规则 3: 检测到对关闭端口的连接尝试
alert tcp any any -> $HOME_NET 3001:3010 (msg:"ET SCAN Connection to closed port range"; flow:stateless; sid:1000003; rev:1; classtype:attempted-recon;)

# 规则 4: HTTP-Alt 端口探测
alert tcp any any -> $HOME_NET 8080 (msg:"ET SCAN HTTP-Alt port probe"; flow:stateless; sid:1000004; rev:1; classtype:attempted-recon;)

# 规则 5: HTTPS-Alt 端口探测
alert tcp any any -> $HOME_NET 8443 (msg:"ET SCAN HTTPS-Alt port probe"; flow:stateless; sid:1000005; rev:1; classtype:attempted-recon;)
