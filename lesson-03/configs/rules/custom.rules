# 端口扫描检测规则
# 检测多种扫描行为

# 规则 1: 检测到多个关闭端口的连接（端口扫描特征）
alert tcp any any -> $HOME_NET 3001:3010 (msg:"ET SCAN Potential Port Scan - connection to closed port"; flow:stateless; flags:S; threshold: type threshold, track by_src, count 3, seconds 60; sid:1000001; rev:1; classtype:attempted-recon;)

# 规则 2: HTTP-Alt 端口探测
alert tcp any any -> $HOME_NET 8080 (msg:"ET SCAN Port Scan - HTTP-Alt probe"; flow:stateless; flags:S; sid:1000002; rev:1; classtype:attempted-recon;)

# 规则 3: HTTPS-Alt 端口探测
alert tcp any any -> $HOME_NET 8443 (msg:"ET SCAN Port Scan - HTTPS-Alt probe"; flow:stateless; flags:S; sid:1000003; rev:1; classtype:attempted-recon;)

# 规则 4: 检测 TCP connect 扫描（完整握手）
alert tcp any any -> $HOME_NET any (msg:"LOCAL Port Scan - TCP connect scan detected"; flow:stateless; flags:S; threshold: type threshold, track by_src, count 5, seconds 30; sid:1000004; rev:1; classtype:attempted-recon;)

# 规则 5: SQL 注入尝试（HTTP 层检测）
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"ET WEB_SQL SQL Injection attempt"; flow:to_server,established; content:"UNION"; nocase; content:"SELECT"; nocase; threshold: type threshold, track by_src, count 3, seconds 60; sid:1000005; rev:1; classtype:web-application-attack;)
